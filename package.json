{
  "name": "kyso",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "react": "^19.2.3",
      "next": "^16.1.1",
      "react-dom": "^19.2.3",
      "better-auth": "^1.4.9",
      "@orpc/server": "^1.12.2",
      "@orpc/client": "^1.12.2",
      "@orpc/openapi": "^1.12.2",
      "@orpc/zod": "^1.12.2",
      "@polar-sh/better-auth": "^1.1.3",
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3",
      "typescript": "^5",
      "@xyflow/react": "^12.10.0",
      "immer": "^11.1.3"
    }
  },
  "type": "module",
  "scripts": {
    "check": "biome check --write .",
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:native": "bun run --filter native dev",
    "dev:web": "bun run --filter @kyso/web dev",
    "db:push": "bun run --filter @kyso/db db:push",
    "db:studio": "bun run --filter @kyso/db db:studio",
    "db:generate": "bun run --filter @kyso/db db:generate",
    "db:migrate": "bun run --filter @kyso/db db:migrate",
    "desktop:dev": "bun run --filter @kyso/web desktop:dev",
    "icon": "bun run --filter @kyso/icons build"
  },
  "dependencies": {
    "@kyso/env": "workspace:*", 
    "dotenv": "catalog:",
    "zod": "catalog:",
    "next": "catalog:",
    "immer": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "ultracite": "6.5.0",
    "typescript": "catalog:",
    "@types/node": "^22.13.11",
    "@kyso/config": "workspace:*"
  },
  "packageManager": "bun@1.3.0"
}
