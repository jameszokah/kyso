{
  "name": "kyso",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "better-auth": "^1.4.9",
      "@polar-sh/better-auth": "^1.1.3",
      "@types/react": "^19.2.7",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "check": "biome check --write .",
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "dev:native": "bun run --filter native dev",
    "dev:web": "bun run --filter web dev",
    "db:push": "bun run --filter @kyso/db db:push",
    "db:studio": "bun run --filter @kyso/db db:studio",
    "db:generate": "bun run --filter @kyso/db db:generate",
    "db:migrate": "bun run --filter @kyso/db db:migrate"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@kyso/env": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "ultracite": "6.5.0",
    "typescript": "^5",
    "@types/node": "^22.13.11",
    "@kyso/config": "workspace:*"
  },
  "packageManager": "bun@1.3.0"
}
